<section class="n9-say n9-io" id="start">
  <div class="n9-wrap">
    <span class="n9-mono n9-enter" id="start-title">Start your free mock · fill in the blanks</span>
    <form class="n9-start" data-start novalidate aria-labelledby="start-title">
      <p class="n9-sent n9-enter" style="--d: 80ms">Hi, I’m <input class="n9-blank" style="width: 6.4em" name="name" placeholder="your name" aria-label="Your name" autocomplete="given-name" required> from <input class="n9-blank" style="width: 7.2em" name="college" placeholder="your college" aria-label="Your college" autocomplete="organization" required>, and my drive is on <input class="n9-blank" style="width: 5.2em" name="drive" placeholder="date" aria-label="Drive date" aria-describedby="start-status">. Send my report to <input class="n9-blank" style="width: 6.6em" name="phone" type="tel" placeholder="+91 phone" inputmode="tel" aria-label="Phone number" autocomplete="tel" pattern="([+]?91 ?-?)?[6-9][0-9]{4} ?[0-9]{5}" required>.<span class="n9-caret" aria-hidden="true"></span></p>
      <p class="n9-start-status n9-mono" id="start-status" role="status" aria-live="polite"></p>
      <div class="n9-say-act n9-enter" style="--d: 160ms">
        <button type="submit" class="n9-liquid lg">Start my free mock <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7"></path><path d="M8 7h9v9"></path></svg></button>
        <span class="alt n9-mono">or <a href="#colleges">bring it to your college</a></span>
      </div>
    </form>
  </div>
</section>
