---
import { appLinks } from '../../data/links';
---
<section class="n9-hero" id="top">
  <div class="n9-arc" aria-hidden="true"></div>
  <canvas class="e-mesh n9-hmesh" data-n9="mesh" aria-hidden="true"></canvas>
  <div class="n9-glow" aria-hidden="true"></div>
  <div class="n9-hero-fade" aria-hidden="true" style="height: 765px"></div>
  <div class="n9-wrap n9-hero-in" style="height: 670px">
    <div class="n9-rule" style="--d: 0ms"></div>
    <div class="n9-meta n9-mono n9-hx" style="--d: 120ms"><span>Voice-only mock interviews</span><span>Pune · Nashik · Mumbai — Est. 2026</span></div>
    <h1 class="n9-h1"><span class="n9-hx grad" style="--d: 90ms">Ace your next interview</span><span class="ind n9-hx" style="--d: 180ms">with a strict <em class="e-serif">AI interviewer</em></span></h1>
    <div class="n9-rule" style="--d: 240ms"></div>
    <div class="n9-row">
      <div class="n9-orb n9-hx" style="--d: 300ms">
        <div class="e-orbslot" data-ai="hero-slot"><span class="e-ring" aria-hidden="true"></span><span class="e-ring" aria-hidden="true"></span><button type="button" class="e-replica" data-ai="hero-rep" aria-label="Open MockDrip AI"><span class="ai-face"><span class="ai-dock-eyes" data-ai="eyes" aria-hidden="true"><i></i><i></i></span></span></button></div>
        <div class="e-status" data-ai="hero-status">Your AI interviewer. Scroll — I’ll come with you.</div>
      </div>
      <p class="n9-sub n9-hx" style="--d: 360ms">A strict 10-minute voice interview in English or Hinglish. Your scored report lands two minutes later — every lost point quoted in your own words.</p>
      <div class="n9-ctas n9-hx" style="--d: 420ms">
        <a href="#preview" class="n9-link n9-mono">Hear a sample <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7"></path><path d="M8 7h9v9"></path></svg></a>
        <a href={appLinks.signup} class="n9-liquid lg">Start free mock <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7"></path><path d="M8 7h9v9"></path></svg></a>
      </div>
    </div>
    <div class="n9-rule" style="--d: 300ms"></div>
  </div>
</section>
