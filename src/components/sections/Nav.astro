---
import { AUTH_LINKS as auth } from '../../data/content';
---
<header class="n9-nav" data-n9="nav">
  <div class="n9-bar">
    <a href="#top" class="n9-pill" aria-label="MockDrip home"><span class="e-logo-mark"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M5 10v4"></path><path d="M9 7v10"></path><path d="M13 9v6"></path><path d="M17 6v12"></path></svg></span><b>Mock<span>Drip</span></b></a>
    <nav class="n9-links" aria-label="Main">
      <a href="#product">Product</a>
      <a href="#features">Features</a>
      <a href="#how">How it works</a>
      <a href="#journey">Your 30 days</a>
      <a href="#pricing">Pricing</a>
    </nav>
    <button type="button" class="n9-tt" data-n9="theme" aria-label="Switch to light theme" aria-pressed="false" title="Light / dark"><svg class="ic m" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.5 14.2A8.5 8.5 0 1 1 9.8 3.5a6.8 6.8 0 0 0 10.7 10.7z"/></svg><svg class="ic s" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg><span class="kn"><svg class="km" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.5 14.2A8.5 8.5 0 1 1 9.8 3.5a6.8 6.8 0 0 0 10.7 10.7z"/></svg><svg class="ks" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg></span></button>
