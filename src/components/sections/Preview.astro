---
import { previewTabs, defaultPreviewTab } from '../../data/content';
const initial = previewTabs.find((t) => t.id === defaultPreviewTab)!;
---
<section class="sec dark" id="preview">
  <div class="glow1" aria-hidden="true"></div>
  <div class="glow2" aria-hidden="true"></div>
  <div class="wrap">
    <div style="display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 28px">
      <div style="max-width: 640px" class="reveal">
        <span class="kicker">Inside the app</span>
        <h2 class="h2">See exactly what you get after every mock</h2>
      </div>
      <div class="tabs" role="group" data-tabs aria-label="Product preview">
        {previewTabs.map((t) => (
          <button type="button" class:list={['tab', { on: t.id === defaultPreviewTab }]} aria-pressed={t.id === defaultPreviewTab ? 'true' : 'false'} data-tab={t.id} data-title={t.title}>{t.label}</button>
        ))}
      </div>
    </div>

    <div class="win reveal">
      <div class="app">
        <div class="app-top">
          <span style="display: flex; gap: 6px" aria-hidden="true"><span style="width: 11px; height: 11px; border-radius: 50%; background: #F0B4B4"></span><span style="width: 11px; height: 11px; border-radius: 50%; background: #F3D9A4"></span><span style="width: 11px; height: 11px; border-radius: 50%; background: #B6E2C3"></span></span>
          <span style="font-weight: 800; font-size: 15px" data-tab-title>{initial.title}</span>
          <span style="margin-left: auto; display: flex; gap: 6px; flex-wrap: wrap"><span class="chip">HR round</span><span class="chip">L2 · Bridge</span><span class="chip hide-sm">Normal</span></span>
        </div>

        <!-- REPORT -->
        <div class="app-body" data-panel="report" hidden>
            <div class="pane" style="display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 16px; text-align: center">
              <div style="position: relative; width: 200px; height: 200px">
                <svg width="200" height="200" viewBox="0 0 140 140" role="img" aria-label="Readiness 68 out of 100">
                  <circle cx="70" cy="70" r="58" fill="none" stroke="#EAF1EC" stroke-width="12"></circle>
                  <circle cx="70" cy="70" r="58" fill="none" stroke="#16A34A" stroke-width="12" stroke-linecap="round" stroke-dasharray="248 365" transform="rotate(-90 70 70)"></circle>
                </svg>
                <div style="position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center">
                  <span class="disp" style="font-size: 60px; font-weight: 700; line-height: 1">68</span>
                  <span style="font-size: 13px; font-weight: 700; color: #5B6E63">readiness / 100</span>
                </div>
              </div>
              <span style="font-size: 14px; font-weight: 800; color: #0F7A37; background: #DCFCE7; padding: 6px 12px; border-radius: 10px">+9 since your last HR mock</span>
              <div style="width: 100%; padding: 14px; border-radius: 16px; background: #FFF7EE; border: 1px solid #F6D8B8; text-align: left">
                <div style="font-size: 12px; font-weight: 800; letter-spacing: .05em; text-transform: uppercase; color: #9A3E0A">Language-gap score</div>
                <div style="font-size: 14px; line-height: 1.5; margin-top: 4px">Your English answers scored <strong>6 points</strong> below your Hinglish ones.</div>
              </div>
            </div>
            <div style="display: flex; flex-direction: column; gap: 16px">
              <div class="pane" style="display: flex; flex-direction: column; gap: 14px">
                <div style="font-size: 13px; font-weight: 800; letter-spacing: .05em; text-transform: uppercase; color: #5B6E63">Five sub-scores</div>
                <div class="sbar"><span>Answer content</span><span class="track-bar"><span class="fill" style="width: 75%"></span></span><span class="mono">15</span></div>
                <div class="sbar"><span>Clarity</span><span class="track-bar"><span class="fill" style="width: 70%"></span></span><span class="mono">14</span></div>
                <div class="sbar"><span>Confidence &amp; pace</span><span class="track-bar"><span class="fill low" style="width: 55%"></span></span><span class="mono">11</span></div>
                <div class="sbar"><span>Language &amp; fluency</span><span class="track-bar"><span class="fill" style="width: 60%"></span></span><span class="mono">12</span></div>
                <div class="sbar"><span>Role fit</span><span class="track-bar"><span class="fill" style="width: 80%"></span></span><span class="mono">16</span></div>
              </div>
              <div class="pane" style="display: flex; flex-direction: column; gap: 12px">
                <div style="font-size: 13px; font-weight: 800; letter-spacing: .05em; text-transform: uppercase; color: #5B6E63">Weakest answer</div>
                <p style="margin: 0; font-size: 15px; line-height: 1.6">You said: “<span class="hl">I am team player and basically I adjust with everyone</span>.”</p>
                <p style="margin: 0; font-size: 15px; line-height: 1.6; padding: 12px 14px; border-radius: 14px; background: #F0FAF3; border: 1px solid #CFE8D7">Try: “In our final-year project, two teammates disagreed on the sensor design. I set up a quick test of both, and we picked the one that worked.”</p>
                <div style="display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap">
                  <span style="font-size: 14px; font-weight: 700; color: #2C4337">Next fix: open every strength with one real example.</span>
                  <a href="#start" class="btn btn-primary" style="min-height: 44px; padding: 0 18px; font-size: 14.5px">Retry this question</a>
                </div>
              </div>
            </div>
          </div>

        <!-- CALL -->
        <div class="app-body" data-panel="call">
            <div class="pane" style="display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 14px; background: radial-gradient(120% 90% at 50% 0%, #FFFFFF, #E9F7EE)">
              <div class="orb-wrap" aria-hidden="true"><span class="ring"></span><span class="ring"></span><span class="ring"></span><div class="orb"><svg class="av-noise"><rect width="100%" height="100%" filter="url(#fxnoise)"></rect></svg><span class="orb-eyes"><i></i><i></i></span></div></div>
              <span class="live"><span class="live-dot"></span>LIVE <span class="mono" style="color: #3D5247">06:48 / 10:00</span></span>
              <div style="display: flex; gap: 10px">
                <button type="button" class="ctrl" aria-label="Mute microphone"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><rect x="9" y="3" width="6" height="11" rx="3"></rect><path d="M5 11a7 7 0 0 0 14 0"></path><path d="M12 18v3"></path></svg></button>
                <button type="button" class="ctrl ctrl-end" aria-label="End interview"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 14.5c5-5 13-5 18 0l-2.2 2.2a1 1 0 0 1-1.3.1l-2.2-1.6a1 1 0 0 1-.4-.9l.2-2a11 11 0 0 0-6.2 0l.2 2a1 1 0 0 1-.4.9l-2.2 1.6a1 1 0 0 1-1.3-.1z"></path></svg></button>
              </div>
            </div>
            <div class="pane" style="display: flex; flex-direction: column; gap: 12px">
              <div style="font-size: 13px; font-weight: 800; letter-spacing: .05em; text-transform: uppercase; color: #5B6E63">Live captions</div>
              <div class="bubble b-ai">Tell me about a time you worked under pressure.</div>
              <div class="bubble b-me">During our college fest the sponsor pulled out two days before. Phir humne local shops se baat ki and collected small sponsorships.</div>
              <div class="bubble b-ai">How much did you raise, and what was your part in it?</div>
              <div class="bubble b-me" style="color: #5B6E63; font-style: italic">We raised around forty thousand… I made the pitch to…</div>
              <div style="display: flex; gap: 8px; flex-wrap: wrap; margin-top: auto"><span class="chip">Follow-up 1 of 1</span><span class="chip">No scores during the call</span></div>
            </div>
          </div>

        <!-- RETRY -->
        <div class="app-body" data-panel="retry" hidden>
            <div class="pane" style="display: flex; flex-direction: column; gap: 14px">
              <div style="font-size: 13px; font-weight: 800; letter-spacing: .05em; text-transform: uppercase; color: #5B6E63">Retry drill · 2 minutes</div>
              <div class="disp" style="font-size: 28px; font-weight: 700; line-height: 1.2">“Tell me about a time you worked in a team.”</div>
              <p style="margin: 0; font-size: 15px; line-height: 1.6; color: #3D5247">One question, one voice turn, scored on the same rubric so before and after are a fair comparison.</p>
              <div style="display: flex; align-items: center; gap: 12px; margin-top: auto; padding: 14px; border-radius: 16px; background: #F0FAF3; border: 1px solid #CFE8D7">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#0F7A37" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"></path></svg>
                <span style="font-size: 14.5px; font-weight: 600">You named the project, your role and the result.</span>
              </div>
            </div>
            <div class="pane" style="display: flex; flex-direction: column; gap: 18px">
              <div style="font-size: 13px; font-weight: 800; letter-spacing: .05em; text-transform: uppercase; color: #5B6E63">Answer content</div>
              <div class="sbar"><span>Before</span><span class="track-bar"><span class="fill low" style="width: 45%"></span></span><span class="mono">9</span></div>
              <div class="sbar"><span>After retry</span><span class="track-bar"><span class="fill" style="width: 75%"></span></span><span class="mono">15</span></div>
              <div style="font-size: 13px; font-weight: 800; letter-spacing: .05em; text-transform: uppercase; color: #5B6E63; margin-top: 8px">Clarity</div>
              <div class="sbar"><span>Before</span><span class="track-bar"><span class="fill low" style="width: 55%"></span></span><span class="mono">11</span></div>
              <div class="sbar"><span>After retry</span><span class="track-bar"><span class="fill" style="width: 70%"></span></span><span class="mono">14</span></div>
              <span style="font-size: 13.5px; font-weight: 600; color: #5B6E63">Free plan: 1 retry per report · Sprint: unlimited</span>
            </div>
          </div>

        <!-- PROGRESS -->
        <div class="app-body" data-panel="progress" hidden>
            <div class="pane">
              <div style="display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 8px">
                <span style="font-size: 13px; font-weight: 800; letter-spacing: .05em; text-transform: uppercase; color: #5B6E63">Readiness · 7 mocks</span>
                <span class="chip">Scoring version verified</span>
              </div>
              <svg viewBox="0 0 420 220" width="100%" height="230" role="img" aria-label="Readiness chart rising from 52 to 74" style="margin-top: 14px; overflow: visible">
                <path d="M20 40H410M20 100H410M20 160H410" stroke="#E3ECE6" stroke-dasharray="4 6"></path>
                <path d="M20 180 L84 162 L148 140 L212 146 L276 112 L340 92 L404 72" fill="none" stroke="#0F7A37" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"></path>
                <path d="M20 196 L84 190 L148 176 L212 178 L276 160 L340 150 L404 138" fill="none" stroke="#EA580C" stroke-width="2.5" stroke-dasharray="6 6" stroke-linecap="round"></path>
                <circle cx="404" cy="72" r="7" fill="#0F7A37" stroke="#BEF264" stroke-width="3"></circle>
                <text x="404" y="56" text-anchor="end" font-size="14" font-weight="700" fill="#0A2216" font-family="Geist Mono, monospace">74</text>
              </svg>
              <div style="display: flex; gap: 18px; font-size: 13px; font-weight: 700; color: #3D5247; flex-wrap: wrap">
                <span style="display: flex; align-items: center; gap: 6px"><span style="width: 16px; height: 3px; background: #0F7A37; border-radius: 2px"></span>Readiness</span>
                <span style="display: flex; align-items: center; gap: 6px"><span style="width: 16px; height: 0; border-top: 2.5px dashed #EA580C"></span>Confidence &amp; pace ×5</span>
              </div>
            </div>
            <div class="pane" style="display: flex; flex-direction: column; gap: 10px">
              <div style="display: flex; justify-content: space-between; align-items: baseline">
                <span style="font-size: 13px; font-weight: 800; letter-spacing: .05em; text-transform: uppercase; color: #5B6E63">Countdown plan</span>
                <span class="mono" style="font-size: 13px; color: #9A3E0A">Drive in 18 days</span>
              </div>
              <div style="display: flex; gap: 14px; align-items: center; padding: 12px 14px; border-radius: 14px; background: #0A2216; color: #FFFFFF"><span class="mono" style="color: #BEF264; width: 52px">Today</span><span style="font-size: 14.5px; font-weight: 600">Retry: “Why should we hire you?”</span></div>
              <div style="display: flex; gap: 14px; align-items: center; padding: 12px 14px; border-radius: 14px; background: #F4F9F5"><span class="mono" style="color: #0F7A37; width: 52px">Day 2</span><span style="font-size: 14.5px; font-weight: 600">Full mock · L3 · Normal</span></div>
              <div style="display: flex; gap: 14px; align-items: center; padding: 12px 14px; border-radius: 14px; background: #F4F9F5"><span class="mono" style="color: #0F7A37; width: 52px">Day 4</span><span style="font-size: 14.5px; font-weight: 600">Drill: confidence &amp; pace</span></div>
              <div style="display: flex; gap: 14px; align-items: center; padding: 12px 14px; border-radius: 14px; background: #F4F9F5"><span class="mono" style="color: #0F7A37; width: 52px">Day 6</span><span style="font-size: 14.5px; font-weight: 600">Full mock · L3 · Strict</span></div>
              <span style="font-size: 13.5px; font-weight: 600; color: #5B6E63; margin-top: auto">Sprint: 6 of 10 mocks left · 22 days left</span>
            </div>
          </div>
      </div>
    </div>
  </div>
</section>
